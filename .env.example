# StudyForge AI — Environment Variables Example
# Copy this file to .env and fill in your values.

# Google Gemini AI API Key — Get yours at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5001

# App Metadata (optional overrides)
VITE_APP_NAME=StudyForge AI
VITE_APP_VERSION=1.0.0

# Feature Flags (optional — defaults defined in src/config/featureFlags.js)
# VITE_FF_INTERVIEW_MODULE=false
# VITE_FF_OFFLINE_MODE=false
# VITE_FF_CLOUD_SYNC=false
# VITE_FF_SPACED_REPETITION=true
